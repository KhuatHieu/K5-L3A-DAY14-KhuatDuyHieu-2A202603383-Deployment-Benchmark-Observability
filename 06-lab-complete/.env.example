# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
#   cp .env.example .env   (file .env đã nằm trong .gitignore)
# Trên Railway / Render: đặt các biến này trong phần Variables / Environment.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — bắt buộc. Tạo key ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — state dùng chung (rate limit, cost). Trong docker compose được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.0

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD). 0 = không giới hạn kỳ đó
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
